language.name = English
mod.cogwork.name = Cogwork
mod.cogwork.description = Tubes, engines and machines that automate mining, crafting and leveling land. Cuboid loaders keep them working with nobody near.
mod.cogwork.authors = Zorro909
tab.cogwork.cogwork = Cogwork


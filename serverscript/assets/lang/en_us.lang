mod.serverscript.name = Serverscript
mod.serverscript.description = Lets a server run scripts that react to events, answer questions and add commands. A server started with {#a0a0a0}--scripts <folder>{/} runs every {#a0a0a0}.rhai{/} file in it; players only need the mod, not the scripts.
